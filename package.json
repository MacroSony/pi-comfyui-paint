{
  "name": "pi-comfyui-paint",
  "version": "0.3.0",
  "type": "module",
  "description": "ComfyUI image/video generation extension for pi coding agent",
  "keywords": [
    "pi-package",
    "pi-extension",
    "comfyui",
    "image-generation",
    "video-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacroSony/pi-comfyui-paint.git"
  },
  "homepage": "https://github.com/MacroSony/pi-comfyui-paint#readme",
  "bugs": {
    "url": "https://github.com/MacroSony/pi-comfyui-paint/issues"
  },
  "files": [
    "src",
    "workflows",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/pi-comfyui-paint-custom-workflow/SKILL.md"
    ]
  },
  "scripts": {
