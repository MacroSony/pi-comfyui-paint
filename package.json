    "check": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "^24.12.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
